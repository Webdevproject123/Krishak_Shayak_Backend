
NODE_ENV=production
PORT=5000


# For local MongoDB: mongodb://localhost:27017/krishak-shayak
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/krishak-shayak
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/krishak-shayak


JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (Vercel deployment URL)
# For local: http://localhost:5173
# For production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Redis (for caching and rate limiting)
# For local: redis://127.0.0.1:6379
# For cloud: redis://username:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# Data.gov.in API Key (for Market Prices)
DATA_GOV_API_KEY=your_data_gov_api_key

# Google Sheets CSV URL (for Government Schemes)
SCHEMES_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?output=csv

# Trust proxy hops (1 for single reverse proxy like Render/Railway/Heroku)
TRUST_PROXY=1

# --- Rate Limiting Configuration ---

# Per IP (protects against one IP flooding the login endpoint)
LOGIN_IP_CAPACITY=20
LOGIN_IP_REFILL_RATE=0.33

# Per Account (protects against brute-force on a single account)
LOGIN_ACCOUNT_CAPACITY=7
LOGIN_ACCOUNT_REFILL_RATE=0.017

# Per IP + Account (protects against one IP targeting one account)
LOGIN_IP_ACCOUNT_CAPACITY=5
LOGIN_IP_ACCOUNT_REFILL_RATE=0.0083

# Failed login exponential backoff
LOGIN_FAIL_BASE_DELAY=1
LOGIN_FAIL_MAX_DELAY=900

# Redis failure behavior: 'open' (allow requests) or 'closed' (reject requests)
RATE_LIMIT_FAIL_MODE=open
