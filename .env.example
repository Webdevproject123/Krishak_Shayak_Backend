# Environment Configuration
# development or production
NODE_ENV=production

# Server Configuration
PORT=5000

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/krishak-shayak
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/krishak-shayak
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/krishak-shayak

# JWT Secret for authentication
# Generate a strong random secret for production
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (Vercel deployment URL)
# For local: http://localhost:5173
# For production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
